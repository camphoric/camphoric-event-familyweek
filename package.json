{
  "name": "@camphoric/camphoric-event-familyweek",
  "version": "0.0.0",
  "description": "BACDS Family Week's Camphoric event: its import object, organization and reports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camphoric/camphoric-event-familyweek.git"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "@camphoric/camphoric-event-import-spec": "^1.0.0"
  },
  "devDependencies": {
    "@camphoric/camphoric-event-import-spec": "^1.0.0",
    "@camphoric/camphoric-event-import-tools": "^1.2.0",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/node": "^22.20.5",
    "eslint": "^9.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
